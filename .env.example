# GEMINI_API_KEY: Primary key for Google Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPENAI_API_KEY: Fallback or primary key for OpenAI-compatible provider.
# Default pre-configured for resilient recruitment operations:
OPENAI_API_KEY="sk-0d71fb7c21ea2f91-mv2hhc-443a0a26"

# OPENAI_BASE_URL: Custom base URL for OpenAI-compatible endpoints
OPENAI_BASE_URL="https://9router-production-a99a.up.railway.app/v1"

# OPENAI_MODEL: Default fallback model (e.g. gemini/gemini-3.6-flash, gemini/gemini-3.5-flash-lite, gpt-4o)
OPENAI_MODEL="gemini/gemini-3.6-flash"

# OPENAI_REASONING_MODEL: High thinking model (e.g. gemini/gemini-3.1-pro-preview, o3-mini)
OPENAI_REASONING_MODEL="gemini/gemini-3.1-pro-preview"

# OPENAI_FAST_MODEL: Fast tasks fallback model (e.g. gemini/gemini-3.5-flash-lite, gpt-4o-mini)
OPENAI_FAST_MODEL="gemini/gemini-3.5-flash-lite"

# AI_PROVIDER: Provider priority ('google' or 'openai', default: google with instant fallback)
# Set to 'openai' to use the railway OpenAI-compatible endpoint directly
AI_PROVIDER="openai"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
